<Window x:Class="RandomNamesWithUI.lib.View.SelectName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RandomNamesWithUI.lib.ViewModel"
        mc:Ignorable="d"
        
        Title="New name"
        Height="300"
        Width="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontSize="20"
        Icon="/img/_35e74fe2-4909-402b-964d-78f341577316-removebg-preview.png"
        SizeToContent="WidthAndHeight">

    <Window.DataContext>
        <local:SelectNameViewModel/>
    </Window.DataContext>

    <Grid Background="BlanchedAlmond">
        <TextBox
            x:Name="NewFileName"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Text=""
            VerticalAlignment="Top"
            Margin="0,50,0,0"
            Width="175"
            TextChanged="RenamingPart_TextChanged"
            />
        <Label
            Content="Enter new name for files:"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="15,10,15,0"
            HorizontalContentAlignment="Center"
            Foreground="SaddleBrown"
            FontWeight="Bold"
            />
        <TextBlock
            Text="{Binding TestNameList}"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            Foreground="SaddleBrown"
            Height="110"
            TextWrapping="WrapWithOverflow"
            Margin="0,90,0,0">
        </TextBlock>
        <Button
            x:Name="ContinueButton"
            Content="Continue"
            HorizontalAlignment="Center"
            Margin="0,210,0,20"
            VerticalAlignment="Top"
            Width="100"
            Height="40"
            Background="SaddleBrown"
            Foreground="BlanchedAlmond"
            Click="ContinueButton_Click"
            />
    </Grid>
</Window>